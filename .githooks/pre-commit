#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# GraphScore pre-commit hook. Runs cpplint and a clang-format 18 verification
# pass over staged GraphScore-owned sources. Both checks use the same
# configuration as CI.
#
# Install with:  ./scripts/bootstrap.sh
#
# CI runs the same checks over the whole tree independently of this hook, so
# a contributor who has not installed it — or who bypasses it with
# `git commit --no-verify` — still cannot merge unformatted code.
#
# POSIX sh, no bashisms: Git invokes hooks with /bin/sh.

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Staged files that are added/copied/modified/renamed (never deleted), under
# the GraphScore-owned source directories, with a C/C++ extension.
staged=$(git diff --cached --name-only --diff-filter=ACMR -z \
  | tr '\0' '\n' \
  | grep -E '^(src|include|apps|tools|tests)/.*\.(c|h|cpp|hpp)$' || true)

if [ -z "$staged" ]; then
  exit 0
fi

status=0

# --- cpplint --------------------------------------------------------------

if command -v cpplint >/dev/null 2>&1; then
  # shellcheck disable=SC2086
  if ! echo "$staged" | xargs cpplint --quiet; then
    echo "pre-commit: cpplint reported violations." >&2
    status=1
  fi
else
  echo "pre-commit: cpplint not found, skipping (install: pip install cpplint)." >&2
fi

# --- clang-format 18 ------------------------------------------------------

clang_format=""
clang_format_major() {
  "$1" --version 2>/dev/null \
    | sed -n 's/.*clang-format version \([0-9][0-9]*\)\(\..*\)\{0,1\}$/\1/p'
}

for candidate in clang-format-18 \
  /opt/homebrew/opt/llvm@18/bin/clang-format \
  /usr/local/opt/llvm@18/bin/clang-format clang-format; do
  if command -v "$candidate" >/dev/null 2>&1; then
    candidate_path=$(command -v "$candidate")
    if [ "$(clang_format_major "$candidate_path")" = "18" ]; then
      clang_format=$candidate_path
      break
    fi
  fi
done

if [ -n "$clang_format" ]; then
  # shellcheck disable=SC2086
  if ! echo "$staged" | xargs "$clang_format" --dry-run -Werror; then
    echo "pre-commit: unformatted files. Fix with: $clang_format -i <file>" >&2
    status=1
  fi
else
  echo "pre-commit: clang-format major 18 is required; formatting cannot be skipped." >&2
  echo "Install one of: brew install llvm@18" >&2
  echo "                sudo apt install clang-format-18" >&2
  echo "                pip install clang-format==18.1.8" >&2
  echo "Apple Command Line Tools clang-format 17 is not supported." >&2
  status=1
fi

if [ "$status" -ne 0 ]; then
  echo "pre-commit: commit rejected. Re-run after fixing, or use" >&2
  echo "            'git commit --no-verify' to defer to CI." >&2
fi

exit "$status"
